# Local session and authentication state.
.Rproj.user/
.Rhistory
.Rdata
.httr-oauth
.DS_Store
.quarto/
**/__pycache__/

# Reproducible development outputs and local tool installations.
/docs/
/.opencode/results/
/.opencode/tools/
/.opencode/notes/
/.Rd2pdf*/

# Native build products; keep source and registration wrappers.
/src/*.o
/src/*.dll
/src/*.so
/src/*.a

# Maintainer-only development files, kept locally and out of the repository.
/.opencode/
/AGENTS.md
/DEVELOPMENT.md
/CONTRIBUTING.md
/Makefile
/MIGRATION.md
/paper/
/tidystata.Rproj
/cran-comments.md
/air.toml
/examples/
/book/
/data-raw/findit/
/data-raw/stata-parity/

# Website reference chapters are regenerated from the installed catalogue.
/vignettes/articles/stata-*.Rmd
/pkgdown/stata-reference-generated/
/pkgdown/assets/stata-reference-links.json
