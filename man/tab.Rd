tab(survey, edu, .wt = w)

tab(survey, edu, .wt = w, .wt_type = "analytic")

# Illustrative indicators for cross-tabulation; keep lifeexp unchanged.
countries <- dplyr::mutate(
  lifeexp,
  lexp_70 = lexp >= 70,
  water_80 = safewater >= 80
